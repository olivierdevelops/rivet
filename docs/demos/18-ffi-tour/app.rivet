# The bundle the 18-ffi-tour demo drives through librivet from a C program
# built outside the repository against the shipped dist/ files.

global GREETING = "hello"

operation demo.add
    name "Add two integers"
    description "Add two signed integers and return their sum."
    param a integer required description "First operand."
    param b integer default 0 description "Second operand; defaults to zero."
    output integer description "Sum of a and b."
    return a + b
end

operation demo.greet
    name "Greet with a global"
    description "Prefix the name with the GREETING global constant."
    param who text required description "Who to greet."
    output text description "GREETING, a space and the name."
    return GREETING + " " + who
end

operation data.read
    name "Read public data"
    description "Read the file policy.json allows."
    output object description "Content of data/public.json."
        field message text required description "Public demo message."
    end
    value = file read "./data/public.json" as json
    return value
end

operation data.private
    name "Try a denied read"
    description "Attempt a path policy.json denies."
    output object description "Never returned under the shipped policy."
        field message text required description "Synthetic fixture message."
    end
    error "permission.denied" description "policy.json denies ./data/private/**."
    value = file read "./data/private/secret.json" as json
    return value
end

operation events.count
    name "Emit a finite sequence"
    description "Emit three values, then return how many were emitted."
    output object description "Summary returned after the last item."
        field count integer required description "Number of items emitted."
    end
    emits integer description "One of 1, 2, 3, in order."
    for value in [1, 2, 3]
        emit value
    end
    return {count: 3}
end

operation chat.echo
    name "Echo live input"
    description "Emit each received text item back, then return how many were echoed."
    output integer description "Number of items echoed."
    emits text description "The received item."
    receives text description "One line of chat."
    count = 0
    for item in incoming
        emit item
        count = count + 1
    end
    return count
end
