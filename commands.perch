#!/usr/bin/env perch
name "rivet"
about "Build, install and maintain Rivet"

requires
    bin "cargo" optional
    bin "cbindgen" optional
    bin "make" optional
    bin "bman" optional
    bin "python3" optional
    bin "vhco" optional
    env "CARGO_TARGET_DIR" optional
    env "CARGO_HOME" optional
    env "RUSTUP_HOME" optional
end

# Developer wrappers approved in vhco-contract.json (overview).
# Commands resolve paths from this file, including when invoked with perch -f.

command build
    description "Build the release rivet binary (the `cli` Cargo feature)"
    dir "${script_dir}"
    do
        cargo build --locked --release --features cli --bin rivet
    end
end

command build_debug
    description "Build the debug rivet binary"
    dir "${script_dir}"
    do
        cargo build --locked --features cli --bin rivet
    end
end

command install
    description "Build the release binary and install globally with bman add"
    dir "${script_dir}"
    do
        cargo build --locked --release --features cli --bin rivet --target-dir "${script_dir}/target"
        bman add "${script_dir}/target/release/rivet${exe_ext}"
    end
end

command check
    description "Type-check every workspace target with all Cargo features"
    dir "${script_dir}"
    do
        cargo check --locked --workspace --all-targets --all-features
    end
end

command tests
    description "Run every workspace test target with all Cargo features"
    dir "${script_dir}"
    do
        # librivet (cdylib/staticlib) must exist for conformance_ffi; cargo test alone does not build it.
        cargo build --locked --workspace --all-features
        cargo test --locked --workspace --all-targets --all-features
    end
end

command clippy
    description "Lint all targets and fail on warnings"
    dir "${script_dir}"
    do
        cargo clippy --locked --workspace --all-targets --all-features -- -D warnings
    end
end

command features
    description "Build the library with no default features and with each Cargo feature alone (T-10)"
    dir "${script_dir}"
    do
        cargo build --locked -p rivet-runtime --no-default-features
        cargo build --locked -p rivet-runtime --no-default-features --features serve
        cargo build --locked -p rivet-runtime --no-default-features --features grpc
        cargo build --locked -p rivet-runtime --no-default-features --features quic
        cargo build --locked -p rivet-runtime --no-default-features --features oauth
        cargo build --locked -p rivet-runtime --no-default-features --features cli
    end
end

command ffi
    description "Build librivet (release), verify rivet.h against cbindgen, and run the C and Python examples"
    dir "${script_dir}"
    do
        cargo build --locked --release -p rivet-ffi
        cbindgen --config ffi/cbindgen.toml --crate rivet-ffi --verify --output ffi/include/rivet.h
        make -C examples/c test
        python3 examples/python/demo.py
        python3 examples/python/modules.py
    end
end

command ffi_header
    description "Regenerate ffi/include/rivet.h with cbindgen (commit the result)"
    dir "${script_dir}"
    do
        cbindgen --config ffi/cbindgen.toml --crate rivet-ffi --output ffi/include/rivet.h
    end
end

command fmt
    description "Format Rust sources"
    dir "${script_dir}"
    do
        cargo fmt --all
    end
end

command fmt_check
    description "Check Rust formatting without modifying files"
    dir "${script_dir}"
    do
        cargo fmt --all -- --check
    end
end

command docs_check
    description "Check documentation metadata, links and indexes"
    dir "${script_dir}"
    do
        python3 scripts/check_docs.py
    end
end

command architecture
    description "Validate VHCO architecture, contract sync and guarantees"
    dir "${script_dir}"
    do
        vhco validate .
        vhco sync .
        vhco check .
    end
end

command gates
    description "Run formatting, type, lint, test, documentation and architecture checks"
    dir "${script_dir}"
    do
        fmt_check
        check
        clippy
        tests
        features
        docs_check
        architecture
    end
end

command help_cli
    description "Build and show rivet --help"
    dir "${script_dir}"
    do
        cargo run --locked --features cli --bin rivet -- --help
    end
end

command live
    description "Serve the design contract at http://127.0.0.1:7777"
    dir "${script_dir}"
    do
        vhco live .
    end
end

command spec
    description "Regenerate vhco.json from code annotations"
    dir "${script_dir}"
    do
        vhco spec .
    end
end

command docs
    description "Regenerate the HTML explorer (vhco.html)"
    dir "${script_dir}"
    do
        vhco doc . --format html
    end
end

command clean
    description "Remove Cargo build artifacts"
    dir "${script_dir}"
    do
        cargo clean
    end
end

command main
    description "List the available development commands"
    dir "${script_dir}"
    do
        print "Rivet development commands (perch <command>):"
        print "  build / build_debug   Build release / debug binary"
        print "  install               Build and install rivet globally with bman"
        print "  check / tests / clippy Type-check, test or lint all targets"
        print "  features              Build each Cargo feature alone (feature matrix)"
        print "  ffi / ffi_header      Build librivet and run the C/Python examples / regenerate rivet.h"
        print "  fmt / fmt_check       Format sources / check formatting"
        print "  docs_check            Validate documentation"
        print "  architecture          Validate VHCO architecture, sync and guarantees"
        print "  gates                 Run all development checks in order"
        print "  help_cli              Show rivet --help"
        print "  live                  Serve the contract explorer"
        print "  spec / docs           Generate vhco.json / vhco.html"
        print "  clean                 Remove Cargo build artifacts"
        print "Use perch --help for command descriptions."
    end
end
