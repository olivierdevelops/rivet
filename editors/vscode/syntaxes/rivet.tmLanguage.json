{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "$comment": "GENERATED by editors/gen_grammar.py from editors/keywords.json (src/infra/rivet.capy); do not edit",
  "name": "Rivet",
  "scopeName": "source.rivet",
  "fileTypes": [
    "rivet"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#import"
    },
    {
      "include": "#global"
    },
    {
      "include": "#operation"
    },
    {
      "include": "#connector"
    },
    {
      "include": "#typed_member"
    },
    {
      "include": "#typed_decl"
    },
    {
      "include": "#for"
    },
    {
      "include": "#node"
    },
    {
      "include": "#assignment"
    },
    {
      "include": "#effect_statement"
    },
    {
      "include": "#declaration_statement"
    },
    {
      "include": "#control_statement"
    },
    {
      "include": "#option_statement"
    },
    {
      "include": "#tail_option"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comment": {
      "match": "(#).*$",
      "name": "comment.line.number-sign.rivet",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.rivet"
        }
      }
    },
    "interpolation": {
      "match": "(\\$\\{)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*)\\s*(\\})",
      "name": "meta.interpolation.rivet",
      "captures": {
        "1": {
          "name": "punctuation.section.interpolation.begin.rivet"
        },
        "2": {
          "name": "variable.other.interpolated.rivet"
        },
        "3": {
          "name": "punctuation.section.interpolation.end.rivet"
        }
      }
    },
    "escape": {
      "match": "\\\\(?:[nrt0\\\\\\\"'`$]|u\\{[0-9A-Fa-f]{1,6}\\}|x[0-9A-Fa-f]{2})",
      "name": "constant.character.escape.rivet"
    },
    "string_double": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.rivet",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "string_single": {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.rivet",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "string_backtick": {
      "begin": "`",
      "end": "`",
      "name": "string.quoted.other.backtick.rivet",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#string_double"
        },
        {
          "include": "#string_single"
        },
        {
          "include": "#string_backtick"
        }
      ]
    },
    "number": {
      "match": "(?<![A-Za-z0-9_.])-?[0-9][0-9_]*(?:\\.[0-9]+)?(?![A-Za-z0-9_])",
      "name": "constant.numeric.rivet"
    },
    "constant": {
      "match": "\\b(?:false|null|true)\\b",
      "name": "constant.language.rivet"
    },
    "builtin_call": {
      "match": "(\\()\\s*(request\\.stream|base64\\.decode|base64\\.encode|xml\\.element|request|length|keys|text)(?![A-Za-z0-9_.])",
      "captures": {
        "2": {
          "name": "support.function.builtin.rivet"
        }
      }
    },
    "operation_call": {
      "match": "(\\()\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+)(?=\\s|\\))",
      "captures": {
        "2": {
          "name": "entity.name.function.operation-id.rivet"
        }
      }
    },
    "effect": {
      "match": "\\b(websocket|command|file|grpc|http|pipe|quic|unix|tcp|udp)\\b(?:\\s+(?!(?:in|as|and|or|not)\\b)([a-z_][a-z0-9_]*)\\b(?![.(]))?(?=\\s+[\\\"'`A-Za-z_\\[{(])",
      "captures": {
        "1": {
          "name": "support.function.effect.rivet"
        },
        "2": {
          "name": "entity.name.function.effect-verb.rivet"
        }
      }
    },
    "operator_word": {
      "match": "\\b(?:and|or|not|in|as)\\b",
      "name": "keyword.operator.word.rivet"
    },
    "operator": {
      "match": "==|!=|<=|>=|\\+=|[-+*/%<>=]",
      "name": "keyword.operator.rivet"
    },
    "variable": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)*\\b",
      "name": "variable.other.rivet"
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#builtin_call"
        },
        {
          "include": "#operation_call"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#number"
        },
        {
          "include": "#effect"
        },
        {
          "include": "#operator_word"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#variable"
        }
      ]
    },
    "type_words": {
      "match": "\\b(?:boolean|integer|number|object|bytes|json|list|text)\\b",
      "name": "support.type.rivet"
    },
    "modifiers": {
      "match": "\\b(?:description|optional|required|default|enum|max|min)\\b",
      "name": "storage.modifier.rivet"
    },
    "import": {
      "match": "^\\s*(import)\\s+(\\\"[^\\\"]*\\\")\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(public))?",
      "captures": {
        "1": {
          "name": "storage.type.declaration.rivet"
        },
        "2": {
          "name": "string.quoted.double.rivet"
        },
        "3": {
          "name": "keyword.operator.word.rivet"
        },
        "4": {
          "name": "variable.other.rivet"
        },
        "5": {
          "name": "storage.type.declaration.rivet"
        }
      }
    },
    "global": {
      "match": "^\\s*(global)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)?",
      "captures": {
        "1": {
          "name": "storage.type.declaration.rivet"
        },
        "2": {
          "name": "variable.other.constant.global.rivet"
        },
        "3": {
          "name": "keyword.operator.assignment.rivet"
        }
      }
    },
    "operation": {
      "match": "^\\s*(operation|pipeline)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": {
          "name": "storage.type.declaration.rivet"
        },
        "2": {
          "name": "entity.name.function.operation-id.rivet"
        }
      }
    },
    "connector": {
      "match": "^\\s*(connector|auth)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*$",
      "captures": {
        "1": {
          "name": "storage.type.declaration.rivet"
        },
        "2": {
          "name": "variable.other.rivet"
        },
        "3": {
          "name": "support.type.rivet"
        }
      }
    },
    "typed_member": {
      "begin": "^\\s*(param|field|secret)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.declaration.rivet"
        },
        "2": {
          "name": "variable.parameter.rivet"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#type_words"
        },
        {
          "include": "#modifiers"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "typed_decl": {
      "begin": "^\\s*(output|emits|receives)(?=\\s|$)(?!\\s*(?:=(?!=)|\\+=))",
      "beginCaptures": {
        "1": {
          "name": "storage.type.declaration.rivet"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#type_words"
        },
        {
          "include": "#modifiers"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "for": {
      "match": "^\\s*(for)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(in)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.rivet"
        },
        "2": {
          "name": "variable.other.rivet"
        },
        "3": {
          "name": "keyword.operator.word.rivet"
        }
      }
    },
    "node": {
      "match": "^\\s*(node)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(after)\\b)?",
      "captures": {
        "1": {
          "name": "keyword.control.rivet"
        },
        "2": {
          "name": "variable.other.rivet"
        },
        "3": {
          "name": "keyword.control.rivet"
        }
      }
    },
    "assignment": {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=(?!=)|\\+=)\\s*(?:(map|poll)\\b(?:\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(in)\\b)?)?",
      "captures": {
        "1": {
          "name": "variable.other.assignment.rivet"
        },
        "2": {
          "name": "keyword.operator.assignment.rivet"
        },
        "3": {
          "name": "keyword.control.rivet"
        },
        "4": {
          "name": "variable.other.rivet"
        },
        "5": {
          "name": "keyword.operator.word.rivet"
        }
      }
    },
    "declaration_statement": {
      "match": "^\\s*(description|connector|operation|pipeline|receives|private|global|import|output|secret|emits|error|field|param|auth|name)(?=\\s|$)(?!\\s*(?:=(?!=)|\\+=))",
      "captures": {
        "1": {
          "name": "storage.type.declaration.rivet"
        }
      }
    },
    "control_statement": {
      "match": "^\\s*(concurrent|iterate|return|after|break|catch|every|scope|while|yield|else|emit|fail|node|poll|task|with|dag|end|for|map|try|if)(?=\\s|$)(?!\\s*(?:=(?!=)|\\+=))",
      "captures": {
        "1": {
          "name": "keyword.control.rivet"
        }
      }
    },
    "option_statement": {
      "begin": "^\\s*(authorization_url|resource_origins|client_secret|max_datagram|redirect_uri|client_auth|interactive|max_streams|chunk_size|descriptor|device_url|if_version|client_id|datagrams|interface|max_frame|migration|multicast|overwrite|reconnect|token_url|transport|audience|debounce|endpoint|loopback|max_body|metadata|redirect|resource|framing|message|missing|service|timeout|version|accept|decode|expose|header|issuer|resume|schema|scopes|stream|allow|limit|query|retry|stdin|store|until|alpn|args|bind|body|flow|open|peer|pkce|unix|cwd|env|tls|ttl)(?=\\s|$)(?!\\s*(?:=(?!=)|\\+=))",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.option.rivet"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#type_words"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "effect_statement": {
      "match": "^\\s*(file)(?=\\s|$)(?!\\s*(?:=(?!=)|\\+=))(?:\\s+([a-z_][a-z0-9_]*)\\b(?![.(]))?",
      "captures": {
        "1": {
          "name": "support.function.effect.rivet"
        },
        "2": {
          "name": "entity.name.function.effect-verb.rivet"
        }
      }
    },
    "tail_option": {
      "match": "(?<=\\s)(as)\\s+(boolean|integer|number|object|bytes|json|list|text)\\b",
      "captures": {
        "1": {
          "name": "keyword.operator.word.rivet"
        },
        "2": {
          "name": "support.type.rivet"
        }
      }
    }
  }
}
