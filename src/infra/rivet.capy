# rivet.capy — Rivet surface grammar (seeded from RES-2026-0001 spike)
# Capy owns statement shapes, blocks, value expressions and spans.
# Rivet lowering owns option-tail validation and semantics.
extension json

comments
    line "#"
end

type OpId
    pattern "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
end

# ---------------------------------------------------------------- closers
function end
end

# ---------------------------------------------------------------- declarations
function operation
    arg literal "operation"
    arg capture id dotted_ident
    block_closer end
end

function pipeline
    arg literal "pipeline"
    arg capture id dotted_ident
    block_closer end
end

function connector
    arg literal "connector"
    arg capture name ident
    arg capture kind ident
    block_closer end
end

function auth_profile
    arg literal "auth"
    arg capture name ident
    arg capture kind ident
    when_followed_by indent
    block_closer end
end

function auth_use
    arg literal "auth"
    arg capture rest tail
    when_not_followed_by indent
end

# ---------------------------------------------------------------- header lines
function name
    arg literal "name"
    arg capture value string
end

function description
    arg literal "description"
    arg capture value string
end

function private
    arg literal "private"
    arg capture value bool
end

function param
    arg literal "param"
    arg capture name ident
    arg capture rest tail
end

function output_block
    arg literal "output"
    arg capture rest tail
    when_followed_by indent
    block_closer end
end

function output
    arg literal "output"
    arg capture rest tail
    when_not_followed_by indent
end

function emits_block
    arg literal "emits"
    arg capture rest tail
    when_followed_by indent
    block_closer end
end

function emits
    arg literal "emits"
    arg capture rest tail
    when_not_followed_by indent
end

function receives_block
    arg literal "receives"
    arg capture rest tail
    when_followed_by indent
    block_closer end
end

function receives
    arg literal "receives"
    arg capture rest tail
    when_not_followed_by indent
end

function field_block
    arg literal "field"
    arg capture name ident
    arg capture rest tail
    when_followed_by indent
    block_closer end
end

function field
    arg literal "field"
    arg capture name ident
    arg capture rest tail
    when_not_followed_by indent
end

function declared_error
    arg literal "error"
    arg capture code string
    arg capture rest tail default ""
end

function secret
    arg literal "secret"
    arg capture name ident
    arg capture rest tail
end

# ---------------------------------------------------------------- body statements
function return
    arg literal "return"
    arg capture value any
    arg capture rest tail default ""
end

function yield
    arg literal "yield"
    arg capture value any
    arg capture rest tail default ""
end

function emit
    arg literal "emit"
    arg capture value any
    arg capture rest tail default ""
end

function fail
    arg literal "fail"
    arg capture code string
    arg capture details any default "null"
end

function break
    arg literal "break"
end

function if
    arg literal "if"
    arg capture cond any
    block_sections else closer end
end

function while
    arg literal "while"
    arg capture cond any
    block_closer end
end

function for
    arg literal "for"
    arg capture var ident
    arg literal "in"
    arg capture iter any
    block_closer end
end

# try body ends at the dedent; the following `catch … end` sibling is paired by Rivet lowering
function try
    arg literal "try"
    block_dedent
end

function catch
    arg literal "catch"
    arg capture filter tail
    block_closer end
end

function dag
    arg literal "dag"
    arg capture rest tail default ""
    block_closer end
end

function node
    arg literal "node"
    arg capture name ident
    arg literal "="
    arg capture value any
end

function node_after
    arg literal "node"
    arg capture name ident
    arg literal "after"
    arg capture deps any
    arg literal "="
    arg capture value any
end

function concurrent
    arg literal "concurrent"
    arg capture rest tail default ""
    block_closer end
end

function task
    arg literal "task"
    arg capture name ident
    block_closer end
end

function scope
    arg literal "scope"
    arg capture rest tail default ""
    block_closer end
end

function iterate
    arg literal "iterate"
    arg capture rest tail
    block_closer end
end

function with
    arg literal "with"
    arg capture rest tail
    block_closer end
end

function file
    arg literal "file"
    arg capture rest tail
    when_not_followed_by indent
end

function file_block
    arg literal "file"
    arg capture rest tail
    when_followed_by indent
    block_closer end
end

# results = map item in [..] limit N \n ... yield v \n end
function assign_map
    priority 20
    arg capture var ident
    arg literal "="
    arg literal "map"
    arg capture item ident
    arg literal "in"
    arg capture iter any
    arg capture rest tail default ""
    block_closer end
end

# status = poll every "1s" until … \n … end
function assign_poll
    priority 20
    arg capture var ident
    arg literal "="
    arg literal "poll"
    arg capture rest tail default ""
    block_closer end
end

# Assignments and method calls outrank option lines: `message = …` and
# `stream.send …` reuse option keywords as variable names.
# x = value [rest]            (flat)
function assign
    priority 10
    arg capture var ident
    arg literal "="
    arg capture value any
    arg capture rest tail default ""
    when_not_followed_by indent
end

# x = http get "url" \n options... end
function assign_block
    priority 10
    arg capture var ident
    arg literal "="
    arg capture value any
    arg capture rest tail default ""
    when_followed_by indent
    block_closer end
end

# x += value
function append_assign
    priority 10
    arg capture var ident
    arg literal "+="
    arg capture value any
end

# socket.send json {...}  /  rpc.finish_send  /  process.stdin.send json {...}
function member_call
    priority 10
    arg capture obj ident
    arg literal "."
    arg capture method dotted_ident
    arg capture rest tail default ""
end

# (request "id" {...})  — bare call statement; only a parenthesised prefix call
type ParenCall
    group_open "("
    group_close ")"
end

function call_stmt
    priority -3
    bare
    arg capture call ParenCall
end

# ---------------------------------------------------------------- option lines (arguments validated by Rivet per resource)

function opt_decode
    arg literal "decode"
    arg capture rest tail default ""
end

function opt_timeout
    arg literal "timeout"
    arg capture rest tail default ""
end

function opt_body
    arg literal "body"
    arg capture rest tail default ""
    when_not_followed_by indent
end

# body multipart … end: `field NAME VALUE` and `file NAME PATH [TYPE]` part lines
function opt_body_block
    arg literal "body"
    arg capture rest tail default ""
    when_followed_by indent
    block_closer end
end

